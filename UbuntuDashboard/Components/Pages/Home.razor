@page "/"

<div class="container mt-4" style="max-width: 900px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Ubuntu Dashboard</h1>
        <p class="text-muted">Zarządzanie i monitorowanie</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-light rounded-3">
                <span class="text-uppercase text-muted fw-bold small">Procesor</span>
                <h2 class="text-primary fw-bold mt-2 mb-0">@CpuUsage %</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-light rounded-3">
                <span class="text-uppercase text-muted fw-bold small">Pamięć RAM</span>
                <h2 class="text-primary fw-bold mt-2 mb-0">@RamUsedGB GB / @RamTotalGB GB</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-light rounded-3">
                <span class="text-uppercase text-muted fw-bold small">Uptime</span>
                <h2 class="fw-bold mt-2 mb-0">@UptimeText</h2>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 p-4">
        <h4 class="fw-bold mb-4">⚙ Zarządzanie usługami</h4>

        <div class="list-group list-group-flush">
            @foreach (var service in Services)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div class="d-flex align-items-center">
                        <span class="fs-2 me-3">@service.Icon</span>
                        <div>
                            <h6 class="fw-bold mb-0">@service.Name</h6>
                            <small class="text-muted">@service.Description</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (service.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold">ACTIVE</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold">INACTIVE</span>
                        }

                        <button class="btn btn-outline-success btn-sm px-3" @onclick="() => StartService(service)">Start</button>
                        <button class="btn btn-outline-danger btn-sm px-3" @onclick="() => StopService(service)">Stop</button>

                        @if (!string.IsNullOrEmpty(service.Url))
                        {
                            <a href="@service.Url" target="_blank" class="btn btn-primary btn-sm px-3">Otwórz ↗</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int CpuUsage = 100;
    private double RamUsedGB = 0.7;
    private double RamTotalGB = 18.9;
    private string UptimeText = "48 minutes";

    // Model danych dla usług
    public class ServiceModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Icon { get; set; } = "⚙️";
        public bool IsActive { get; set; }
        public string? Url { get; set; }
    }

    // Lista usług wyświetlana w dashboardzie
    private List<ServiceModel> Services = new()
    {
        new ServiceModel
        {
            Name = "Minecraft Server",
            Description = "Serwer gry Survival",
            Icon = "🎮",
            IsActive = false
        },
        new ServiceModel
        {
            Name = "FinanceApp",
            Description = "Port 5005",
            Icon = "💰",
            IsActive = false,
            Url = "http://localhost:5005"
        }
    };

    // Metody obsługujące kliknięcia przycisków
    private void StartService(ServiceModel service)
    {
        service.IsActive = true;
    }

    private void StopService(ServiceModel service)
    {
        service.IsActive = false;
    }
}